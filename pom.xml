<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.littlejlib</groupId>
    <artifactId>littlejlib-proj</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <description>proj - the index of every repository on this machine, and the PRP tool. Maven coordinates, git state, dependency graph and Maven Central status across all configured code bases, with a keyboard-first picker and a resident daemon.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>littlejlib.proj.Main</main.class>
        <exec.mainClass>${main.class}</exec.mainClass>
        <arcadedb.version>26.7.3</arcadedb.version>
        <datahelper.version>1.4</datahelper.version>
        <datahelper.processor.version>1.0</datahelper.processor.version>
        <!-- ArcadeDB 26.x calls com.google.gson.Strictness, absent before Gson 2.11.
             An older Gson resolves fine and then kills the DB at startup. -->
        <gson.version>2.14.0</gson.version>
        <!-- JavaFX version. Default 17 (Windows). The macOS build overrides to
             21 (-Djavafx.version=21): JavaFX 17 crashes on modern macOS with
             'invalid NSTrackingRectTag' (JDK-8296654, fixed in JavaFX 20). -->
        <javafx.version>17</javafx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>3.25.1</version>
        </dependency>

        <!-- ArcadeDB. Pinned to the same version as jacli (littlejlib-jacli), which
             joins this classpath in phase D; two ArcadeDB versions in one shaded jar
             do not coexist. -->
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>${arcadedb.version}</version>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-server</artifactId>
            <version>${arcadedb.version}</version>
        </dependency>

        <!-- @ArcadeData: DTO generation plus the typed Query/Upsert API. Replaces the
             initialize_document_schema + document_crud_helper pair. -->
        <dependency>
            <groupId>io.github.xyz-jphil</groupId>
            <artifactId>xyz-jphil-arcadedb-datahelper</artifactId>
            <version>${datahelper.version}</version>
        </dependency>

        <!-- SetConsoleOutputCP(65001) in-process, via FFM. Replaces the `chcp 65001`
             that proj.bat used to run before the JVM; proj.exe has no batch wrapper
             left to do it. -->
        <dependency>
            <groupId>io.github.xyz-jphil</groupId>
            <artifactId>xyz-jphil-windows_console_set_unicode_output</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- Lombok for cleaner code -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>

        <!-- Gson for JSON serialization -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- jsoup reads pom.xml. maven-model would pull plexus-utils for the same
             six fields, and MavenXpp3Reader does not resolve <parent> inheritance
             either, so it buys nothing here. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>

        <!-- Picocli for command-line interface -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.7</version>
        </dependency>

        <!-- JavaFX for UI picker. Version via ${javafx.version}; native
             platform via -Djavafx.platform (win by default, mac-aarch64/mac for
             macOS). All four modules are pinned to the same version so the
             AutocompletionTextField control's older transitive javafx (incl.
             fxml, whose 11 default has no mac-aarch64 classifier) is overridden. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- AutocompletionTextField control -->
        <dependency>
            <groupId>io.github.xyz-jphil.jfx</groupId>
            <artifactId>xyz-jphil-jfx-controls-AutocompletionTextField</artifactId>
            <version>1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                        <path>
                            <groupId>io.github.xyz-jphil</groupId>
                            <artifactId>xyz-jphil-arcadedb-datahelper-processor</artifactId>
                            <version>${datahelper.processor.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
